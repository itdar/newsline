#!/usr/bin/env bash
# newsline — single CLI entrypoint for the local news status-line utility.
#
#   newsline init        interactive setup: language, topic, status-line wiring.
#                        COMPOSES with an existing status line (e.g. your HUD),
#                        so rate-limit / context info stays visible.
#   newsline color [c]   set the headline color (or cycle to the next when no name).
#   newsline colorlist   list the available headline colors with a live preview.
#   newsline render      what settings.json runs each refresh (base HUD + news).
#   newsline refresh     force a cache refresh now.
#   newsline once        fetch + print headlines once (debug).
#   newsline uninstall   remove the wiring, restore what was there.
#   newsline help
#
# Profiles: init / uninstall act on EVERY Claude Code profile — ~/.claude plus
# each ~/.claude-*/ dir that holds a .claude.json or settings.json (dirs used via
# CLAUDE_CONFIG_DIR). Each profile keeps its own base status line. Pass
# --settings <file> (or NEWSLINE_SETTINGS) to act on one settings file only.
#
# Test overrides: NEWSLINE_SETTINGS, NEWSLINE_CONFIG_DIR, NEWSLINE_CACHE.
set -u

# resolve our real dir even when invoked via a PATH symlink (so helpers are found)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in /*) ;; *) SOURCE="$DIR/$SOURCE" ;; esac
done
HERE="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
CONFIG_DIR="${NEWSLINE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/newsline}"
CONFIG="$CONFIG_DIR/config.json"
# one explicit settings file (env or --settings); empty = every profile
SETTINGS="${NEWSLINE_SETTINGS:-}"

# Command written into settings.json. ALWAYS an absolute path — Claude Code runs
# the status line in a non-login shell whose PATH may not include ~/.local/bin.
# init appends `--settings <file>` so render can pick that profile's base line.
NL_BIN="$(command -v newsline 2>/dev/null || echo "$HERE/newsline")"

# settings_targets — print the settings files to act on, one per line.
# Explicit file wins; else ~/.claude (always) + each ~/.claude-*/ profile dir.
# Dirs are resolved (cd -P) so a symlinked profile is not processed twice.
settings_targets() {
  if [ -n "$SETTINGS" ]; then
    # resolve to an absolute real path so the key in config.json matches the
    # default-target keys and is the same from any working directory
    local sdir sbase
    sdir="$(dirname "$SETTINGS")"; sbase="$(basename "$SETTINGS")"
    if [ -d "$sdir" ]; then sdir="$(cd -P "$sdir" && pwd)"
    else case "$sdir" in /*) ;; *) sdir="$PWD/$sdir" ;; esac; fi
    printf '%s\n' "$sdir/$sbase"; return 0
  fi
  local d real seen=$'\n'
  for d in "$HOME/.claude" "$HOME"/.claude-*/; do
    d="${d%/}"
    if [ -d "$d" ]; then
      real="$(cd -P "$d" 2>/dev/null && pwd)" || continue
    elif [ "$d" = "$HOME/.claude" ]; then
      real="$d"                                   # default profile: created on demand
    else
      continue
    fi
    # only real Claude Code profile dirs, never an unrelated ~/.claude-backup etc.
    if [ "$d" != "$HOME/.claude" ] && [ ! -e "$real/.claude.json" ] && [ ! -e "$real/settings.json" ]; then
      continue
    fi
    case "$seen" in *$'\n'"$real"$'\n'*) continue ;; esac
    seen="$seen$real"$'\n'
    printf '%s\n' "$real/settings.json"
  done
}

# ---- tiny JSON helpers (python; no jq dependency) ----
cfg_get() { # cfg_get <key>
  python3 - "$CONFIG" "$1" <<'PY' 2>/dev/null
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: d={}
v=d.get(sys.argv[2])
print("" if v is None else v)
PY
}

# One python spawn for the whole config (render runs on every status-line tick;
# per-key cfg_get calls here would cost ~10 interpreter startups per tick).
load_config() { # load_config [settings-file] — with a file, use that profile's base
  [ -f "$CONFIG" ] || return 0
  local exports
  exports=$(python3 - "$CONFIG" "${1:-}" <<'PY' 2>/dev/null
import json,sys,shlex
env={"lang":"NEWSLINE_LANG","topic":"NEWSLINE_TOPIC","rotate":"NEWSLINE_ROTATE",
     "count":"NEWSLINE_COUNT","maxlen":"NEWSLINE_MAXLEN","icon":"NEWSLINE_ICON",
     "color":"NEWSLINE_COLOR","linkhint":"NEWSLINE_LINKHINT","api":"NEWSLINE_API",
     "endpoint":"NEWSLINE_ENDPOINT","base_statusline":"NEWSLINE_BASE",
     "clickhint":"NEWSLINE_CLICKHINT","stock":"NEWSLINE_STOCK",
     "stock_codes":"NEWSLINE_STOCK_CODES"}
try: d=json.load(open(sys.argv[1]))
except Exception: d={}
for k,name in env.items():
    v=d.get(k)
    if v is None or v=="": continue
    if k=="lang" and v=="auto": continue
    print("export %s=%s" % (name, shlex.quote(str(v))))
# per-profile base (init stores one entry per settings file, even when empty)
key=sys.argv[2] if len(sys.argv)>2 else ""
bases=d.get("bases")
if key and isinstance(bases,dict) and isinstance(bases.get(key),dict):
    b=bases[key].get("command") or ""
    print("export NEWSLINE_BASE=%s" % shlex.quote(b) if b else "unset NEWSLINE_BASE")
PY
)
  [ -n "$exports" ] && eval "$exports"
}

detect_lang() {
  local raw="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
  if command -v defaults >/dev/null 2>&1; then
    raw="$(defaults read NSGlobalDomain AppleLocale 2>/dev/null || echo "$raw")"
  fi
  raw="${raw%%.*}"; raw="${raw%%@*}"; local l="${raw%%_*}"; l="${l%%-*}"
  echo "${l:-en}"
}

lang_label() {  # code -> native (English) display name
  case "$1" in
    ko) echo "한국어 (Korean)" ;;        ja) echo "日本語 (Japanese)" ;;
    en) echo "English" ;;                 es) echo "Español (Spanish)" ;;
    fr) echo "Français (French)" ;;       de) echo "Deutsch (German)" ;;
    pt) echo "Português (Portuguese)" ;;  zh) echo "中文 (Chinese)" ;;
    *)  echo "$1" ;;
  esac
}

# choose <default_code> <code1> <label1> <code2> <label2> ...  -> sets $CHOICE
CHOICE=""
choose() {
  local def="$1"; shift
  local -a codes=() labels=()
  while [ $# -gt 0 ]; do codes+=("$1"); labels+=("${2:-$1}"); shift 2; done
  local i defnum=1
  for i in "${!codes[@]}"; do
    [ "${codes[$i]}" = "$def" ] && defnum=$((i + 1))
    printf "  %2d) %s\n" "$((i + 1))" "${labels[$i]}" >&2
  done
  printf "  # [%d]: " "$defnum" >&2
  local sel; read -r sel < "${NL_TTY:-/dev/stdin}"
  case "$sel" in ''|*[!0-9]*) sel="$defnum" ;; esac
  if [ "$sel" -ge 1 ] 2>/dev/null && [ "$sel" -le "${#codes[@]}" ] 2>/dev/null; then
    CHOICE="${codes[$((sel - 1))]}"
  else
    CHOICE="$def"
  fi
}

# ---- subcommands ----
cmd_render() { # base (existing HUD) first, newsline below — never blocks
  local key=""
  [ "${1:-}" = "--settings" ] && key="${2:-}"
  load_config "$key"
  local input=""
  [ -t 0 ] || input=$(cat 2>/dev/null)     # consume the session JSON if piped
  if [ -n "${NEWSLINE_BASE:-}" ]; then
    printf '%s' "$input" | eval "$NEWSLINE_BASE" 2>/dev/null   # your HUD, unchanged
    printf '\n'
  fi
  "$HERE/statusline.sh"                                # the news line, below
}

cmd_refresh() { load_config; "$HERE/refresh.sh"; }

cmd_once() {
  load_config; "$HERE/refresh.sh"
  local dir="${NEWSLINE_CACHE:-$HOME/.cache/newsline}"
  [ -s "$dir/line" ] && cat "$dir/line" && echo
}

cmd_init() {
  local lang="" topic="" color="" api="" endpoint="" rotate="6" count="15" compose="auto" yes="0" base_override="" rotate_set=0 stock="" stock_set=0 stock_codes="" a
  while [ $# -gt 0 ]; do
    case "$1" in
      --lang) lang="$2"; shift 2;;      --topic) topic="$2"; shift 2;;
      --api) api="$2"; shift 2;;        --endpoint) endpoint="$2"; shift 2;;
      --rotate) rotate="$2"; rotate_set=1; shift 2;;  --count) count="$2"; shift 2;;
      --base) base_override="$2"; shift 2;;
      --stock) stock="$2"; stock_set=1; shift 2;;     --stock-codes) stock_codes="$2"; shift 2;;
      --compose) compose="yes"; shift;; --no-compose) compose="no"; shift;;
      --settings) SETTINGS="$2"; shift 2;; --yes|-y) yes="1"; shift;;
      *) shift;;
    esac
  done

  local detected; detected=$(detect_lang)
  # Interactive input source: stdin if it's a tty, else the controlling terminal
  # (/dev/tty) — this lets `curl … | sh` still prompt the user.
  NL_TTY=""
  if [ "$yes" = "0" ]; then
    if [ "${NEWSLINE_FORCE_TTY:-}" = "1" ] || [ -t 0 ]; then NL_TTY=/dev/stdin
    elif [ -r /dev/tty ]; then NL_TTY=/dev/tty; fi
  fi
  if [ -n "$NL_TTY" ]; then
    if [ -z "$lang" ]; then
      # languages that actually have bundled feeds, offered as a numbered menu
      local avail c; local -a menu=(auto "Auto-detect (now: $(lang_label "$detected"))")
      avail=$(python3 -c "import json,sys;d=json.load(open(sys.argv[1]));print(' '.join(k for k in d if k not in ('default','_comment')))" "$HERE/feeds.json" 2>/dev/null)
      for c in $avail; do menu+=("$c" "$(lang_label "$c")"); done
      echo "Newsline language?" >&2
      choose "$detected" "${menu[@]}"; lang="$CHOICE"
    fi
    if [ -z "$topic" ]; then
      echo "Newsline topic?" >&2
      choose general \
        general "General" tech "Tech" business "Business" world "World" \
        sports "Sports" science "Science" health "Health" entertainment "Entertainment"
      topic="$CHOICE"
    fi
    local cur_color; cur_color=$(cfg_get color)
    echo "Newsline color?" >&2
    choose "${cur_color:-magenta}" \
      default "Terminal default" cyan "Cyan" gray "Gray" white "White" \
      yellow "Yellow" green "Green" blue "Blue" magenta "Magenta" red "Red"
    color="$CHOICE"
    if [ "$rotate_set" = "0" ]; then
      # rotation interval — free-form seconds; blank/invalid keeps the current value
      local cur_rotate; cur_rotate=$(cfg_get rotate); [ -n "$cur_rotate" ] || cur_rotate="$rotate"
      echo "Newsline seconds?" >&2
      printf "  # [%s]: " "$cur_rotate" >&2
      local sel_rotate; read -r sel_rotate < "${NL_TTY:-/dev/stdin}"
      case "$sel_rotate" in
        ''|*[!0-9]*) rotate="$cur_rotate" ;;   # blank or non-numeric -> keep current
        *)           rotate="$sel_rotate" ;;
      esac
      [ "$rotate" -ge 1 ] 2>/dev/null || rotate=6
    fi
    if [ "$stock_set" = "0" ]; then
      # KOSPI top-5 ticker line, shown below the news — off by default
      local cur_stock; cur_stock=$(cfg_get stock); [ "$cur_stock" = "on" ] || cur_stock="off"
      echo "Show KOSPI top 5 stock ticker below the news?" >&2
      choose "$cur_stock" on "Yes" off "No"
      stock="$CHOICE"
    fi
  else
    # --yes: keep a color previously set via init/`newsline color`; magenta on first run
    lang="${lang:-$detected}"; topic="${topic:-general}"
    color=$(cfg_get color); [ -n "$color" ] || color="magenta"
    # keep an existing rotation interval on re-init unless --rotate was given
    if [ "$rotate_set" = "0" ]; then
      local saved_rotate; saved_rotate=$(cfg_get rotate); [ -n "$saved_rotate" ] && rotate="$saved_rotate"
    fi
    # keep an existing stock setting on re-init unless --stock was given; off on first run
    if [ "$stock_set" = "0" ]; then
      stock=$(cfg_get stock); [ -n "$stock" ] || stock="off"
    fi
  fi
  [ -n "$stock_codes" ] || stock_codes=$(cfg_get stock_codes)
  [ -n "$stock_codes" ] || stock_codes="top5"

  # Wire every profile. Each one KEEPS its own existing status line and shows
  # newsline below it (no prompt). Only --no-compose (or --base) changes this.
  #   first run:  capture that profile's real status line as its base
  #   re-init:    keep the base already saved for that profile (or the legacy
  #               single base_statusline from older versions)
  local -a targets=(); local t
  while IFS= read -r t; do [ -n "$t" ] && targets+=("$t"); done < <(settings_targets)

  mkdir -p "$CONFIG_DIR"
  local rc=0
  python3 - "$CONFIG" "$NL_BIN" "$compose" "$base_override" \
      "$lang" "$topic" "$rotate" "$count" "$api" "$endpoint" "$color" "$stock" "$stock_codes" \
      "${targets[@]}" <<'PY' || rc=$?
import json,os,shlex,sys
(_,cfg_path,nl_bin,compose,base_override,lang,topic,rotate,count,api,endpoint,
 color,stock,stock_codes)=sys.argv[:14]
targets=sys.argv[14:]
try:
    d={"lang":lang,"topic":topic,"rotate":int(rotate),"count":int(count)}
except ValueError:
    sys.stderr.write("newsline: --rotate/--count must be integers\n"); sys.exit(3)
if color and color not in ("default","none","off"): d["color"]=color
if api: d["api"]=api
if endpoint: d["endpoint"]=endpoint
if stock == "on":
    d["stock"]=stock
    if stock_codes: d["stock_codes"]=stock_codes

try: old=json.load(open(cfg_path))
except Exception: old={}
if not isinstance(old,dict): old={}
bases=old.get("bases") if isinstance(old.get("bases"),dict) else {}
legacy={"command":old.get("base_statusline") or ""}
if isinstance(old.get("base_statusline_obj"),dict): legacy["obj"]=old["base_statusline_obj"]

def read_settings(path):
    if not os.path.exists(path): return {}
    with open(path) as f: raw=f.read().strip()
    s=json.loads(raw) if raw else {}
    if not isinstance(s,dict): raise ValueError("settings root is not an object")
    return s

failed=0
plan=[]                       # (path, settings, base entry) — written after config
for path in targets:
    try: s=read_settings(path)
    except Exception:
        # never clobber a settings file we can't parse
        sys.stderr.write("✗ %s is not valid JSON; refusing to modify it\n" % path)
        failed+=1; continue
    sl=s.get("statusLine"); cur=sl.get("command","") if isinstance(sl,dict) else ""
    entry={"command":""}
    if base_override:
        entry={"command":base_override}
    elif compose!="no":
        if cur and "newsline" not in cur:
            entry={"command":cur,"obj":sl}                 # verbatim, for uninstall
        elif isinstance(bases.get(path),dict):
            entry=bases[path]
        elif cur:                                          # wired by an older version
            entry=legacy
    bases[path]=entry
    plan.append((path,s,entry))

if bases: d["bases"]=bases
# keep legacy keys so a status line wired by an older version still renders
if compose!="no" and not base_override and legacy["command"]:
    d["base_statusline"]=legacy["command"]
    if "obj" in legacy: d["base_statusline_obj"]=legacy["obj"]
# save the original status lines FIRST: if this fails, no settings file is touched
try:
    tmp=cfg_path+".tmp"
    with open(tmp,"w") as f: json.dump(d,f,indent=2,ensure_ascii=False)
    os.replace(tmp,cfg_path)
except Exception as e:
    sys.stderr.write("✗ could not write %s: %s\n" % (cfg_path,e)); sys.exit(4)

for path,s,entry in plan:
    s["statusLine"]={"type":"command",
                     "command":'"%s" render --settings %s' % (nl_bin, shlex.quote(path)),
                     "refreshInterval":5}
    try:
        os.makedirs(os.path.dirname(path) or ".",exist_ok=True)
        tmp=path+".tmp"
        with open(tmp,"w") as f: json.dump(s,f,indent=2,ensure_ascii=False)
        os.replace(tmp,path)
    except Exception as e:
        # its bases entry is harmless: uninstall drops entries newsline does not manage
        sys.stderr.write("✗ could not update %s: %s\n" % (path,e))
        failed+=1; continue
    note="  composing with: %s" % entry["command"] if entry.get("command") else ""
    print("  ✔ %s%s" % (path, ("\n  "+note) if note else ""))
sys.exit(1 if failed else 0)
PY
  [ "$rc" = "3" ] || [ "$rc" = "4" ] && return 1

  # apply the new language/topic on the next render, not after the old cache expires
  local cache="${NEWSLINE_CACHE:-$HOME/.cache/newsline}"
  rm -f "$cache/line" "$cache/feeds.resolved.json" "$cache/feeds.resolved.ok" "$cache/notice" "$cache/stock.line" 2>/dev/null

  echo "✔ newsline installed (lang=$lang, topic=$topic)."
  [ "$stock" = "on" ] && echo "  KOSPI top 5 ticker: on (below the news)."
  echo "  It appears on your next message to Claude — no restart needed."
  if [ "$rc" != "0" ]; then
    echo "✗ some settings files were skipped — fix them and re-run: newsline init" >&2
    return 1
  fi
}

# canonical headline palette — single source of truth for cycling, listing, and
# validation. "default" means the terminal's own color (no SGR); the rest map to
# the SGR codes in statusline.sh (nl_sgr below mirrors that mapping).
NL_PALETTE="default gray white cyan yellow green blue magenta red"

nl_sgr() { # color name -> SGR params (empty = terminal default). Mirrors statusline.sh.
  case "$1" in
    dim)        echo "2"  ;;
    gray|grey)  echo "90" ;;
    red)        echo "31" ;;  green)   echo "32" ;;  yellow) echo "33" ;;
    blue)       echo "34" ;;  magenta) echo "35" ;;  cyan)   echo "36" ;;
    white)      echo "37" ;;  orange)  echo "38;5;208" ;;
    *)          echo ""   ;;
  esac
}

nl_write_color() { # nl_write_color <name> — persist the chosen color to config
  mkdir -p "$CONFIG_DIR"
  python3 - "$CONFIG" "$1" <<'PY' || { echo "✗ could not write $CONFIG" >&2; return 1; }
import json,os,sys
path,color=sys.argv[1],sys.argv[2]
try: d=json.load(open(path))
except Exception: d={}
if color in ("default","none","off"): d.pop("color",None)
else: d["color"]=color
tmp=path+".tmp"
with open(tmp,"w") as f: json.dump(d,f,indent=2,ensure_ascii=False)
os.replace(tmp,path)
PY
}

cmd_colorlist() { # newsline colorlist — list the palette, each shown in its own color
  local cur c sgr mark; cur=$(cfg_get color); [ -n "$cur" ] || cur=default
  echo "Headline colors (set with: newsline color <name>):"
  for c in $NL_PALETTE; do
    [ "$c" = "$cur" ] && mark="  ← current" || mark=""
    sgr=$(nl_sgr "$c")
    if [ -n "$sgr" ]; then
      printf '  \033[%sm%-8s 📰 sample headline\033[0m%s\n' "$sgr" "$c" "$mark"
    else
      printf '  %-8s 📰 sample headline%s\n' "$c" "$mark"
    fi
  done
}

cmd_color() { # newsline color [name] — set a color; with no name, step to the next one
  local cur new arg; arg="${1:-}"
  case "$arg" in list|ls|--list) cmd_colorlist; return $? ;; esac
  if [ -n "$arg" ]; then
    new="$(printf '%s' "$arg" | tr '[:upper:]' '[:lower:]')"
    case "$new" in grey) new=gray ;; none|off) new=default ;; esac
    case " $NL_PALETTE " in
      *" $new "*) ;;
      *) echo "✗ unknown color: $arg" >&2
         echo "  choose from: $NL_PALETTE   (see: newsline colorlist)" >&2
         return 1 ;;
    esac
  else                                   # no name: cycle to the next color, wrapping
    cur=$(cfg_get color)
    new=$(NL_PALETTE="$NL_PALETTE" python3 - "${cur:-default}" <<'PY'
import os,sys
p=os.environ["NL_PALETTE"].split()
c=sys.argv[1]
print(p[(p.index(c)+1)%len(p)] if c in p else p[0])
PY
)
  fi
  nl_write_color "$new" || return 1
  echo "✔ headline color: $new — preview:"
  load_config
  "$HERE/statusline.sh"; echo
}

cmd_uninstall() {
  local purge=0 a
  while [ $# -gt 0 ]; do
    case "$1" in
      --purge|-p) purge=1; shift;;
      --settings) SETTINGS="${2:-}"; shift 2;;
      *) shift;;
    esac
  done
  local -a targets=(); local t
  while IFS= read -r t; do [ -n "$t" ] && targets+=("$t"); done < <(settings_targets)
  # revert each profile to ITS saved base; prints "keep" when other profiles
  # still use newsline (then the shared config must stay)
  local left scope="all"
  [ -n "$SETTINGS" ] && scope="one"
  left=$(python3 - "$CONFIG" "$scope" "${targets[@]}" <<'PY'
import json,os,sys
cfg_path=sys.argv[1]; scope=sys.argv[2]; targets=sys.argv[3:]
try: cfg=json.load(open(cfg_path))
except Exception: cfg={}
if not isinstance(cfg,dict): cfg={}
bases=cfg.get("bases") if isinstance(cfg.get("bases"),dict) else {}
legacy={"command":cfg.get("base_statusline") or ""}
if isinstance(cfg.get("base_statusline_obj"),dict): legacy["obj"]=cfg["base_statusline_obj"]

for path in targets:
    try:
        with open(path) as f: raw=f.read().strip()
        d=json.loads(raw) if raw else {}
        if not isinstance(d,dict): raise ValueError("settings root is not an object")
    except FileNotFoundError:
        sys.stderr.write("  %s: no settings file; nothing to revert\n" % path); continue
    except Exception:
        sys.stderr.write("  %s: not valid JSON; left as-is\n" % path); continue
    sl=d.get("statusLine"); cmd=sl.get("command","") if isinstance(sl,dict) else ""
    if "newsline" not in cmd:
        sys.stderr.write("  %s: status line not managed by newsline; left as-is\n" % path)
        bases.pop(path,None); continue
    entry=bases.get(path) if isinstance(bases.get(path),dict) else legacy
    obj=entry.get("obj")
    if isinstance(obj,dict) and obj.get("command"):
        d["statusLine"]=obj                    # full original (keeps padding etc.)
    elif entry.get("command"):
        d["statusLine"]={"type":"command","command":entry["command"]}
    else:
        d.pop("statusLine",None)
    tmp=path+".tmp"
    with open(tmp,"w") as f: json.dump(d,f,indent=2,ensure_ascii=False)
    os.replace(tmp,path)
    bases.pop(path,None)
    sys.stderr.write("  %s: reverted status line\n" % path)

def still_wired(p):
    try:
        sl=json.load(open(p)).get("statusLine")
        return "newsline" in (sl.get("command","") if isinstance(sl,dict) else "")
    except Exception:
        return False
if scope=="all":
    # full uninstall: drop stale entries (deleted profile, file no longer wired)
    # so they do not block removal of the shared config
    bases={k:v for k,v in bases.items() if still_wired(k)}
if bases and os.path.exists(cfg_path):          # other profiles still wired
    cfg["bases"]=bases
    tmp=cfg_path+".tmp"
    with open(tmp,"w") as f: json.dump(cfg,f,indent=2,ensure_ascii=False)
    os.replace(tmp,cfg_path)
    print("keep")
PY
)
  local cache="${NEWSLINE_CACHE:-$HOME/.cache/newsline}"
  if [ "$left" = "keep" ]; then
    echo "✔ newsline removed from the selected profile(s); other profiles still use it."
    return 0
  fi
  rm -f "$CONFIG" "$cache/line" "$cache/feeds.resolved.json" "$cache/feeds.resolved.ok" "$cache/notice" 2>/dev/null
  echo "✔ newsline uninstalled."

  [ "$purge" = "1" ] || return 0
  # --purge: also remove the CLI binary + the PATH line install.sh added. Only for
  # the install.sh layout ($PREFIX/share/newsline + $PREFIX/bin/newsline); a
  # package-managed install (brew/npm) is left to its own package manager.
  case "$HERE" in
    */share/newsline)
      local prefix bin rc
      prefix="$(cd "$HERE/../.." 2>/dev/null && pwd)"; bin="$prefix/bin"
      if [ -e "$bin/newsline" ]; then
        rm -f "$bin/newsline"
        rm -rf "$HERE"                       # $PREFIX/share/newsline (this script's dir)
        for rc in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.profile" "$HOME/.config/fish/config.fish"; do
          [ -f "$rc" ] || continue
          awk -v bin="$bin" '
            function strip(p){ sub(/^\/private/, "", p); return p }   # macOS /var == /private/var
            /^# added by newsline installer$/ {
              marker=$0
              if ((getline pl) > 0) {
                drop=0
                if (match(pl, /\/[^ "]*\/bin/)) {
                  d=substr(pl, RSTART, RLENGTH)
                  if (strip(d) == strip(bin)) drop=1   # our block -> drop marker + path line
                }
                if (drop) next
                print marker; print pl; next
              }
              print marker; next
            }
            { print }
          ' "$rc" > "$rc.nltmp" 2>/dev/null && mv "$rc.nltmp" "$rc"
        done
        echo "✔ purged CLI: removed $bin/newsline and its PATH entry (open a new shell to refresh PATH)."
      else
        echo "ℹ nothing to purge (no $bin/newsline)."
      fi
      ;;
    *)
      echo "ℹ this CLI wasn't installed via install.sh (looks package-managed);"
      echo "  remove it with:  brew uninstall newsline   or   npm uninstall -g newsline-cli"
      ;;
  esac
}

usage() {
  cat <<'EOF'
newsline — local news status-line utility
  newsline init [--lang ko] [--topic tech]    set up & wire the status line
                [--rotate SECS] [--stock on]  (asks language / topic / color / rotation / stock)
                [--stock-codes top5]          wires every profile: ~/.claude and
                [--settings FILE]             each ~/.claude-*/ (or only FILE)
  newsline color [name]                      set headline color (e.g. cyan, gray); with
                                              no name, step to the next: default → gray →
                                              white → cyan → yellow → green → blue →
                                              magenta → red → back to default
  newsline colorlist                          list the available colors with a preview
  newsline uninstall [--purge]                remove & restore previous status line
                     [--settings FILE]        in every profile (or only FILE)
                                              (--purge also deletes the CLI + PATH line)
EOF
  if [ "${1:-}" = "--all" ]; then
    cat <<'EOF'

internal (Claude Code calls these automatically; for debugging only):
  newsline render      draw the status line now (HUD + news)
  newsline refresh     force a cache refresh
  newsline once        fetch + print headlines once
EOF
  fi
}

case "${1:-help}" in
  render) shift; cmd_render "$@";;
  refresh) shift; cmd_refresh "$@";;
  once) shift; cmd_once "$@";;
  init) shift; cmd_init "$@";;
  color) shift; cmd_color "$@";;
  colorlist|colors) shift; cmd_colorlist;;
  uninstall) shift; cmd_uninstall "$@";;
  help|-h|--help) shift; usage "$@";;
  *) usage; exit 1;;
esac
